local L=require("../../src/parry_learning")
local l=L.new({version=1,records={bad={time=-1,count=5}}})
assert(l.records.bad==nil)
assert(not l:observe("1",0.4))
assert(not l:observe("1",0.42))
local ok,t=l:observe("1",0.41)
assert(ok and math.abs(t-0.41)<0.0001)
local saved=l:export()
local restored=L.new(saved)
assert(restored.records["1"].time==t)
assert(not restored:observe("1",0/0))
assert(not restored:observe("1",math.huge))
local noisy=L.new()
noisy:observe("2",0.1)
noisy:observe("2",0.8)
assert(not noisy:observe("2",1.4))
assert(noisy:export().records["2"]==nil)
restored:observe("1",0.7)
restored:observe("1",0.71)
local changed,newTime=restored:observe("1",0.72)
assert(changed and newTime<=t+0.040001)
print("PASS: consensus, noisy rejection, bounds, persistence, bounded updates")
